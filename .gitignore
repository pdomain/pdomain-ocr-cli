.venv/
__pycache__/
*.pyc
dist/
*.egg-info/

# Test cache
.pytest_cache/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.xml

# Local uv source overrides (e.g. pointing pdomain-book-tools at a local path)
uv.toml
Makefile.local

# Claude Code session state stays local. settings.json is the project hook
# file shared by Claude and Grok, so it is the one tracked exception.
.claude/*
!.claude/settings.json

# Local git worktrees created for repo-scoped agent work.
.worktree/
.worktrees/


# AI=1 just output capture log
.ci-ai.log

# local-dev mode marker (written by scripts/local-dev.sh)
.venv/.pdomain-local-mode
